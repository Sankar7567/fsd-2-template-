<h1>Student Form</h1>

<form action="/submit" method="POST">

    <input
        type="text"
        name="name"
        placeholder="Enter name">

    <br><br>

    <input
        type="number"
        name="age"
        placeholder="Enter age">

    <br><br>

    <button type="submit">

        Submit

    </button>

</form>